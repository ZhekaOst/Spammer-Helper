<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <title>Пособник спамера - Редагування</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark">
<nav class="navbar navbar-dark bg-black mb-4 border-bottom border-secondary">
  <div class="container">
    <span class="navbar-brand fw-semibold">Пособник спамера</span>
    <div>
      <a href="/" class="btn btn-outline-secondary btn-sm me-2">Розсилка</a>
      <a href="/manage" class="btn btn-secondary btn-sm">Керування списком</a>
    </div>
  </div>
</nav>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card bg-dark-subtle border-secondary shadow-sm">
        <div class="card-header bg-black border-secondary">
          <span class="fw-semibold text-light">Редагування контакту</span>
        </div>
        <div class="card-body">
          <form action="/manage/edit/<%= contact.id %>" method="POST">
            <div class="mb-3">
              <label class="form-label small text-light">Прізвище</label>
              <input type="text" name="last_name" class="form-control form-control-sm" value="<%= contact.last_name %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label small text-light">Ім'я</label>
              <input type="text" name="first_name" class="form-control form-control-sm" value="<%= contact.first_name %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label small text-light">По батькові</label>
              <input type="text" name="middle_name" class="form-control form-control-sm" value="<%= contact.middle_name %>" required>
            </div>
            <div class="mb-4">
              <label class="form-label small text-light">Email</label>
              <input type="email" name="email" class="form-control form-control-sm" value="<%= contact.email %>" required>
            </div>
            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-secondary btn-sm flex-grow-1">Зберегти</button>
              <a href="/manage" class="btn btn-outline-secondary btn-sm">Скасувати</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
